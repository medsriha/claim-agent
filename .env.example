ENVIRONMENT=local
LOG_LEVEL=INFO
JSON_LOGS=false

SHIPBOB_BASE_URL=http://localhost:8080
SHIPBOB_TIMEOUT_SECONDS=10
SHIPBOB_MAX_ATTEMPTS=3

DATABASE_PATH=claim_agent.db

ANTHROPIC_API_KEY=
MODEL=claude-opus-5

POLICY_REIMBURSEMENT_CAP_USD=100.00
POLICY_MAX_CLAIM_AGE_DAYS=60
POLICY_AGE_LIMIT_INCLUSIVE=true
POLICY_HIGH_VALUE_ORDER_USD=500.00
POLICY_HIGH_VALUE_INCLUSIVE=true
POLICY_DAMAGED_IN_TRANSIT_SUB_CATEGORY=Claim | Damaged in Transit
POLICY_MIN_DESCRIPTION_LENGTH=1
POLICY_MAX_AGENT_STEPS=12
POLICY_MAX_TOOL_CALLS_PER_STEP=6
POLICY_MAX_IMAGE_ANALYSES_PER_RUN=20
POLICY_CAP_APPLIES_TO_WHOLE_CLAIM=true

ATTACHMENT_TIMEOUT_SECONDS=20
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_CACHE_DIR=.attachment-cache

MODEL_TIMEOUT_SECONDS=120
MODEL_MAX_ATTEMPTS=2
